<?xml version="1.0" encoding="utf-8"?>
<!-- داده‌ها به ابر گوگل یا گوشی دیگر نمی‌رود؛ پشتیبان را کاربر خودش می‌گیرد. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
